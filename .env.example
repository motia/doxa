# Host ownership for files created by Syncthing.
PUID=1000
PGID=1000
UMASK=002

# Paths may be absolute. The vault contains Shared/ and Private/.
VAULT_PATH=./data/vault
SYNCTHING_CONFIG_PATH=./data/syncthing
SYNCTHING_DEVICE_NAME=doxa-vps

# Syncthing UI is loopback-only; use SSH tunneling if you need remote setup.
SYNCTHING_GUI_PORT=8384
SYNCTHING_SYNC_PORT=22000

# MCP binds to loopback only. Put Cloudflare Tunnel or another trusted ingress in front.
MCP_PORT=3010
PUBLIC_BASE_URL=https://doxa-managed.motiavated.com
MCP_ALLOWED_OPS=read,list,search,write,mkdir,move
MCP_MAX_FILE_BYTES=10485760

# OAuth secrets and persistent client/token state. These paths are ignored under data/.
OAUTH_MASTER_KEY_PATH=./data/oauth/oauth-master.key
OAUTH_SECRETS_PATH=./data/oauth/oauth-secrets.enc
OAUTH_STATE_DIR=./data/oauth/state
